{
  "manifest_version": 3,
  "name": "Tab Unloader",
  "version": "1.0.0",
  "description": "Выгружает неактивные вкладки, когда свободной памяти становится мало.",
  "permissions": ["tabs", "system.memory", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Unloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
