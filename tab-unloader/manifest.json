{
  "manifest_version": 3,
  "name": "Tab Unloader",
  "version": "1.0.0",
  "description": "Выгружает неактивные вкладки, когда свободной памяти становится мало.",
  "permissions": [
    "tabs",
    "system.memory",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Unloader"
  }
}
